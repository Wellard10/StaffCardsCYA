table 'CYA TLE'
	lineageTag: 91ec0120-7f42-410d-b41f-5c62f0f2c08c

	measure 'TLE Events (Timeline)' =
			
			VAR SelectedPerson = SELECTEDVALUE ( 'New Reg Data'[Attendee ID] )
			VAR SelectedEventType = SELECTEDVALUE ( 'CYA TLE'[Event type] )
			VAR CurrentDate = SELECTEDVALUE ( 'Timeline Dates'[Date] )
			RETURN
			    IF (
			        SelectedPerson = BLANK ()
			            || SelectedEventType = BLANK ()
			            || CurrentDate = BLANK (),
			        BLANK (),
			        CALCULATE (
			            COUNTROWS ( 'CYA TLE' ),
			            ALL ( 'CYA TLE' ),
			            'CYA TLE'[Attendee ID] = SelectedPerson,
			            'CYA TLE'[Event type] = SelectedEventType,
			            'CYA TLE'[Event date] = CurrentDate
			        )
			    )
		formatString: 0
		lineageTag: 417f156f-7876-47a7-b15f-6155a19a58b8

	measure 'TLE Events (Timeline Tooltip)' =
			
			VAR SelectedPerson = SELECTEDVALUE ( 'New Reg Data'[Attendee ID] )
			VAR CurrentDate = SELECTEDVALUE ( 'Timeline Dates'[Date] )
			RETURN
			    IF (
			        SelectedPerson = BLANK ()
			            || CurrentDate = BLANK (),
			        BLANK (),
			        VAR EventDetails =
			            CALCULATETABLE (
			                SUMMARIZE (
			                    'CYA TLE',
			                    'CYA TLE'[Event type],
			                    'CYA TLE'[Event value]
			                ),
			                ALL ( 'CYA TLE' ),
			                'CYA TLE'[Attendee ID] = SelectedPerson,
			                'CYA TLE'[Event date] = CurrentDate
			            )
			        RETURN
			            IF (
			                COUNTROWS ( EventDetails ) = 0,
			                BLANK (),
			                CONCATENATEX (
			                    EventDetails,
			                    'CYA TLE'[Event type]
			                        & IF (
			                            NOT ISBLANK ( 'CYA TLE'[Event value] ),
			                            ": " & 'CYA TLE'[Event value],
			                            ""
			                        ),
			                    UNICHAR ( 10 )
			                )
			            )
			    )
		lineageTag: 863d1f20-2ad9-4745-97e5-8df5d98a8031

	measure 'TLE Timeline Position' =
			VAR SelectedPerson = SELECTEDVALUE ( 'New Reg Data'[Attendee ID] )
			VAR CurrentDate = SELECTEDVALUE ( 'Timeline Dates'[Date] )
			VAR EventCount =
			    IF (
			        NOT ISBLANK ( SelectedPerson ) && NOT ISBLANK ( CurrentDate ),
			        CALCULATE (
			            COUNTROWS ( 'CYA TLE' ),
			            'CYA TLE'[Attendee ID] = SelectedPerson,
			            'CYA TLE'[Event date] = CurrentDate
			        ),
			        0
			    )
			VAR EventType = SELECTEDVALUE ( 'CYA TLE'[Event type] )
			VAR IsMilestone =
			    EventType IN {
			        "Accreditation",
			        "Enrichment Fund Payment",
			        "Entered Education",
			        "Gained Apprenticeship",
			        "Gained Employment - Full Time",
			        "Gained Employment - Kickstart",
			        "Gained Employment - Other",
			        "Gained Employment - Part Time",
			        "Gained Volunteering",
			        "Gained Work Experience / Work Trail / Work Taster",
			        "ME Tool Score",
			        "ME Tool Action Plan",
			        "ME Tool Stage",
			        "Offer of Education, Employment or Training",
			        "Offer of Interview",
			        "Official decision received - DWP Aligned",
			        "Participated in Work Trial",
			        "Received Funding",
			        "Receiving Driving Lessons",
			        "Sustained Employment / Education"
			    }
			RETURN
			    IF ( EventCount > 0, IF ( IsMilestone, 2, 1 ), BLANK () )
		formatString: 0
		lineageTag: 5a7c9e8f-1d2b-4c3e-9f1a-2b8d7c6e5f4a

	measure 'TLE Timeline Size' =
			VAR SelectedPerson = SELECTEDVALUE ( 'New Reg Data'[Attendee ID] )
			VAR CurrentDate = SELECTEDVALUE ( 'Timeline Dates'[Date] )
			VAR EventCount =
			    IF (
			        NOT ISBLANK ( SelectedPerson ) && NOT ISBLANK ( CurrentDate ),
			        CALCULATE (
			            COUNTROWS ( 'CYA TLE' ),
			            'CYA TLE'[Attendee ID] = SelectedPerson,
			            'CYA TLE'[Event date] = CurrentDate
			        ),
			        0
			    )
			VAR EventType = SELECTEDVALUE ( 'CYA TLE'[Event type] )
			VAR IsMilestone =
			    EventType IN {
			        "Accreditation",
			        "Enrichment Fund Payment",
			        "Entered Education",
			        "Gained Apprenticeship",
			        "Gained Employment - Full Time",
			        "Gained Employment - Kickstart",
			        "Gained Employment - Other",
			        "Gained Employment - Part Time",
			        "Gained Volunteering",
			        "Gained Work Experience / Work Trail / Work Taster",
			        "ME Tool Score",
			        "ME Tool Action Plan",
			        "ME Tool Stage",
			        "Offer of Education, Employment or Training",
			        "Offer of Interview",
			        "Official decision received - DWP Aligned",
			        "Participated in Work Trial",
			        "Received Funding",
			        "Receiving Driving Lessons",
			        "Sustained Employment / Education"
			    }
			RETURN
			    IF ( EventCount > 0, IF ( IsMilestone, 50, 10 ), BLANK () )
		formatString: 0
		lineageTag: 8b3d4a5c-6e7f-8a9b-0c1d-2e3f4a5b6c7d

	measure 'TLE Count for Selected Person' =
			VAR SelectedPerson = SELECTEDVALUE ( 'New Reg Data'[Attendee ID] )
			RETURN
			    IF (
			        NOT ISBLANK ( SelectedPerson ),
			        CALCULATE (
			            COUNTROWS ( 'CYA TLE' ),
			            FILTER ( ALL ( 'CYA TLE' ), 'CYA TLE'[Attendee ID] = SelectedPerson )
			        ),
			        BLANK ()
			    )
		formatString: 0
		lineageTag: 9c4d5e6f-7a8b-9c0d-1e2f-3a4b5c6d7e8f

	measure 'Event End Date' =
			VAR EventDate = SELECTEDVALUE ( 'CYA TLE'[Event date] )
			RETURN
			    IF ( NOT ISBLANK ( EventDate ), EventDate + 1, BLANK () )
		lineageTag: a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d

	measure 'Milestone Count for Selected Person' =
			VAR SelectedPerson = SELECTEDVALUE ( 'New Reg Data'[Attendee ID] )
			RETURN
			    IF (
			        NOT ISBLANK ( SelectedPerson ),
			        CALCULATE (
			            COUNTROWS ( 'CYA TLE' ),
			            'CYA TLE'[Attendee ID] = SelectedPerson,
			            'CYA TLE'[Event type] IN {
			                "Accreditation",
			                "Enrichment Fund Payment",
			                "Entered Education",
			                "Gained Apprenticeship",
			                "Gained Employment - Full Time",
			                "Gained Employment - Kickstart",
			                "Gained Employment - Other",
			                "Gained Employment - Part Time",
			                "Gained Volunteering",
			                "Gained Work Experience / Work Trail / Work Taster",
			                "ME Tool Score",
			                "ME Tool Action Plan",
			                "ME Tool Stage",
			                "Offer of Education, Employment or Training",
			                "Offer of Interview",
			                "Official decision received - DWP Aligned",
			                "Participated in Work Trial",
			                "Received Funding",
			                "Receiving Driving Lessons",
			                "Sustained Employment / Education"
			            }
			        ),
			        BLANK ()
			    )
		formatString: 0
		lineageTag: b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e

