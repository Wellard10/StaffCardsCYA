	column 'Event value (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('CYA TLE'[Event value]),
				"(Blank)",
				'CYA TLE'[Event value] IN {"Actively engaging"},
				"Actively engaging",
				"Other"
			)
		lineageTag: 41eb40e5-006e-468f-9d9f-1763ce08955d
		summarizeBy: none

